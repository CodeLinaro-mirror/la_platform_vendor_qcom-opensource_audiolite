/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <safelinux-system-cfg/oot-dt-bindings/qcom-ipcc.h>
#include <audiolite-dt-bindings/qcom-audiolite-ipcc.h>
#include <audiolite-dt-bindings/qcom-shmem.h>

/ {
	model = "Qualcomm SA8775P Ride";
	compatible = "qcom,sa8775p-ride", "qcom,sa8775p";
};


&soc {
	ipcc_compute_l0: audiolite@448000 {
		compatible = "qcom,sa8775p-ipcc", "qcom,ipcc";
		reg = <0x0 0x448000 0x0 0x1000>;
		interrupts = <GIC_SPI 230 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <3>;
		#mbox-cells = <2>;
	};

	ipcc_self_ping_apss_cl0: ipcc-self-ping-apss_cl0 {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_APSS_NS1
				IPCC_COMPUTE_L0_SIGNAL_MSG>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_APSS_NS1
				IPCC_COMPUTE_L0_SIGNAL_MSG
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_apss_cl0_ack: ipcc-self-ping-apss_cl0_ack {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_APSS_NS1
				IPCC_COMPUTE_L0_SIGNAL_ACK>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_APSS_NS1
				IPCC_COMPUTE_L0_SIGNAL_ACK
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_adsp_cl0: ipcc-self-ping-adsp_cl0 {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_LPASS
				IPCC_COMPUTE_L0_SIGNAL_MSG>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_LPASS
				IPCC_COMPUTE_L0_SIGNAL_MSG
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_adsp_cl0_ack: ipcc-self-ping-adsp_cl0_ack {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_LPASS
				IPCC_COMPUTE_L0_SIGNAL_ACK>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_LPASS
				IPCC_COMPUTE_L0_SIGNAL_ACK
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_gpdsp0_cl0: ipcc-self-ping-gpdsp0_cl0 {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_GPDSP0
				IPCC_COMPUTE_L0_SIGNAL_MSG>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_GPDSP0
				IPCC_COMPUTE_L0_SIGNAL_MSG
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_gpdsp0_cl0_ack: ipcc-self-ping-gpdsp0_cl0_ack {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_GPDSP0
				IPCC_COMPUTE_L0_SIGNAL_ACK>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_GPDSP0
				IPCC_COMPUTE_L0_SIGNAL_ACK
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_gpdsp1_cl0: ipcc-self-ping-gpdsp1_cl0 {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_GPDSP1
				IPCC_COMPUTE_L0_SIGNAL_MSG>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_GPDSP1
				IPCC_COMPUTE_L0_SIGNAL_MSG
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	ipcc_self_ping_gpdsp1_cl0_ack: ipcc-self-ping-gpdsp1_cl0_ack {
		compatible = "qcom,ipcc-self-ping";
		mboxes = <&ipcc_compute_l0 IPCC_CLIENT_GPDSP1
				IPCC_COMPUTE_L0_SIGNAL_ACK>;
		interrupt-parent = <&ipcc_compute_l0>;
		interrupts = <IPCC_CLIENT_GPDSP1
				IPCC_COMPUTE_L0_SIGNAL_ACK
				IRQ_TYPE_EDGE_RISING>;
		memory-region = <&ipc_shared_mem>;
		dma-coherent;
	};

	umd_audiolite@448000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x00448000 0x0 0x1000>;

		interrupts-extended = <&ipcc_compute_l0 IPCC_CLIENT_LPASS   IPCC_COMPUTE_L0_SIGNAL_MSG IRQ_TYPE_EDGE_RISING>,
							  <&ipcc_compute_l0 IPCC_CLIENT_GPDSP0  IPCC_COMPUTE_L0_SIGNAL_MSG IRQ_TYPE_EDGE_RISING>,
							  <&ipcc_compute_l0 IPCC_CLIENT_GPDSP1  IPCC_COMPUTE_L0_SIGNAL_MSG IRQ_TYPE_EDGE_RISING>,
							  <&ipcc_compute_l0 IPCC_CLIENT_LPASS   IPCC_COMPUTE_L0_SIGNAL_ACK IRQ_TYPE_EDGE_RISING>,
							  <&ipcc_compute_l0 IPCC_CLIENT_GPDSP0  IPCC_COMPUTE_L0_SIGNAL_ACK IRQ_TYPE_EDGE_RISING>,
							  <&ipcc_compute_l0 IPCC_CLIENT_GPDSP1  IPCC_COMPUTE_L0_SIGNAL_ACK IRQ_TYPE_EDGE_RISING>;

		iommus = <&apps_smmu 0x8E0 0x0>;
		dma-coherent;
	};

	auto_vm_0: gh-secure-vm-loader@0 {
		shared-regions = <&ipc_shared_mem>;
	};
};


&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	ipc_shared_mem: ipc_shared_mem@0xad000000 {
		compatible = "shared-dma-pool";
		no-map;
		reg = <0x0 0xad000000 0x0 0x2000000>;
		qcom,dst-vmids = <VMID_ADSP_Q6 AC_VM_SSC_Q6 VMID_GPDSP1_Q6>;
		qcom,dst-perms = <QCOM_PERM_RWX QCOM_PERM_RWX QCOM_PERM_RWX>;
		qcom,src-vmids = <VMID_ADSP_Q6 AC_VM_SSC_Q6 VMID_GPDSP1_Q6>;
		qcom,src-perms = <QCOM_PERM_RWX QCOM_PERM_RWX QCOM_PERM_RWX>;
		qcom,is-shared;
		gunyah-label = <0x49>;
	};
};